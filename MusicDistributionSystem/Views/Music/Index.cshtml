@model MusicDistributionSystem.Application.DTOs.Music.MusicIndexDto
@{
    ViewData["Title"] = "Music Library - Discover & Stream";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold text-light m-0">🎵 Music Library</h2>
        <p class="text-muted small m-0">Browse latest releases, singles, and tracks across all genres</p>
    </div>
    @if (User.IsInRole("Artist") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <a asp-action="Upload" class="btn btn-brand">+ Upload Track</a>
    }
</div>

<!-- Search & Category Filters -->
<div class="glass-card p-3 mb-4">
    <form method="get" class="row g-2 align-items-center">
        <div class="col-md-6">
            <input type="text" name="searchTerm" class="form-control" placeholder="Search by song title or artist..." value="@Model.SearchTerm" />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select">
                <option value="">All Categories & Genres</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Id" selected="@(Model.CategoryId == cat.Id ? "selected" : null)">@cat.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-brand w-100">Filter</button>
        </div>
    </form>
</div>

<!-- Music Cards Grid -->
@if (Model.Tracks.Any())
{
    <div class="media-grid mb-4">
        @foreach (var track in Model.Tracks)
        {
            <div class="media-card">
                <div class="media-cover-container">
                    <img src="@(track.CoverImagePath ?? "/images/default-cover.jpg")" alt="@track.Title" class="media-cover-img" loading="lazy" />
                    <button class="play-hover-btn" 
                            data-play-track 
                            data-track-id="@track.Id"
                            data-track-title="@track.Title"
                            data-track-artist="@track.Artist"
                            data-track-cover="@(track.CoverImagePath ?? "/images/default-cover.jpg")"
                            title="Play Track"
                            aria-label="Play @track.Title">
                        ▶
                    </button>
                </div>
                <div class="media-title" title="@track.Title">
                    <a asp-action="Details" asp-route-id="@track.Id" class="text-light">@track.Title</a>
                </div>
                <div class="media-sub">@track.Artist</div>
                <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25">
                    <span class="badge-tier badge-tier-@track.AccessLevel.ToString().ToLower()">@track.AccessLevel</span>
                    <div class="d-flex gap-2 align-items-center">
                        <button class="btn btn-sm text-muted p-1" data-like-track="@track.Id" title="Like" aria-label="Like @track.Title">❤️</button>
                        <a href="/Media/DownloadMusic/@track.Id" class="text-muted small" title="Download" aria-label="Download @track.Title">⬇ @track.DownloadCount</a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (Model.TotalCount > Model.PageSize)
    {
        int totalPages = (int)Math.Ceiling((double)Model.TotalCount / Model.PageSize);
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination pagination-sm">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == Model.Page ? "active" : "")">
                        <a class="page-link bg-dark text-light border-secondary" href="?page=@p&searchTerm=@Model.SearchTerm&categoryId=@Model.CategoryId">@p</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
else
{
    <div class="glass-card p-5 text-center my-4">
        <h4 class="text-muted">No music tracks found</h4>
        <p class="text-secondary">Try searching for a different keyword or category.</p>
    </div>
}
