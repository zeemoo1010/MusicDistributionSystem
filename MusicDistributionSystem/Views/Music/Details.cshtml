@model MusicDistributionSystem.Application.DTOs.Music.MusicDetailsDto
@{
    ViewData["Title"] = $"{Model.Title} by {Model.Artist}";
}

<div class="row g-4">
    <!-- Left: Track Hero & Audio Stream Trigger -->
    <div class="col-lg-5">
        <div class="glass-card p-4 text-center">
            <img src="@(Model.CoverImagePath ?? "/images/default-cover.jpg")" alt="@Model.Title" class="w-100 rounded-4 mb-3 shadow-lg" style="aspect-ratio: 1/1; object-fit: cover;" />
            <h3 class="fw-bold text-light mb-1">@Model.Title</h3>
            <h5 class="text-muted mb-3">@Model.Artist</h5>
            <div class="d-flex justify-content-center gap-2 mb-4">
                <span class="badge-tier badge-tier-@Model.AccessLevel.ToString().ToLower()">@Model.AccessLevel</span>
                <span class="badge bg-secondary bg-opacity-25 text-light">@(Model.CategoryName ?? "Music")</span>
            </div>

            <!-- Big Stream Play Button -->
            <div class="d-grid gap-2">
                <button class="btn btn-brand btn-lg py-3" 
                        data-play-track 
                        data-track-id="@Model.Id"
                        data-track-title="@Model.Title"
                        data-track-artist="@Model.Artist"
                        data-track-cover="@(Model.CoverImagePath ?? "/images/default-cover.jpg")">
                    ▶ Play Full Track
                </button>
                <a href="/Media/DownloadMusic/@Model.Id" class="btn btn-outline-glass btn-lg">
                    ⬇ Direct Download MP3
                </a>
            </div>

            <!-- Stats Meta -->
            <div class="row g-2 mt-4 pt-3 border-top border-secondary border-opacity-25 text-center text-muted small">
                <div class="col-4">
                    <div class="fw-bold text-light fs-5">@Model.PlayCount</div>
                    <div>Plays</div>
                </div>
                <div class="col-4">
                    <div class="fw-bold text-light fs-5">@Model.DownloadCount</div>
                    <div>Downloads</div>
                </div>
                <div class="col-4">
                    <div class="fw-bold text-light fs-5">@Model.LikeCount</div>
                    <div>Likes</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Right: Description, Artist Link, Comments -->
    <div class="col-lg-7">
        <!-- Description -->
        <div class="glass-card p-4 mb-4">
            <h4 class="fw-bold text-light mb-3">About this Release</h4>
            <p class="text-secondary lead" style="font-size: 1rem;">
                @(Model.Description ?? "No description available for this record.")
            </p>
            <div class="d-flex justify-content-between align-items-center text-muted small mt-3 pt-3 border-top border-secondary border-opacity-25">
                <span>Uploaded by: <strong class="text-light">@Model.UploadedByName</strong></span>
                <span>Released: @Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="glass-card p-4">
            <h4 class="fw-bold text-light mb-3">💬 Listener Discussion (@Model.Comments.Count)</h4>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="AddComment" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="trackId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="2" placeholder="Leave a review or comment..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-brand">Post Comment</button>
                </form>
            }
            else
            {
                <div class="p-3 rounded-3 mb-4 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                    <span class="text-muted">Want to join the conversation? </span>
                    <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold">Log in to comment</a>
                </div>
            }

            <!-- Comments List -->
            @if (Model.Comments.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var comment in Model.Comments)
                    {
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-light">👤 @comment.Username</strong>
                                <span class="text-muted small">@comment.CreatedAt.ToString("g")</span>
                            </div>
                            <p class="text-secondary m-0">@comment.Content</p>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small m-0">Be the first to leave a comment on this release!</p>
            }
        </div>
    </div>
</div>
