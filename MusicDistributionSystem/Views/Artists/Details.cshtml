@model MusicDistributionSystem.Application.DTOs.ArtistDtos.ArtistDetailsDto
@{
    ViewData["Title"] = $"{Model.Name} - Profile & Discography";
}

<!-- Artist Banner Hero -->
<div class="glass-card p-4 p-md-5 mb-5 position-relative overflow-hidden">
    <div class="row align-items-center g-4">
        <div class="col-md-auto text-center">
            <img src="@(Model.ProfilePicturePath ?? "/images/default-avatar.jpg")" alt="@Model.Name" class="rounded-circle shadow-lg" style="width: 160px; height: 160px; object-fit: cover; border: 4px solid #8b5cf6;" />
        </div>
        <div class="col-md">
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50">Verified Artist</span>
                @if (!string.IsNullOrWhiteSpace(Model.Country))
                {
                    <span class="badge bg-secondary bg-opacity-25 text-light">@Model.Country</span>
                }
            </div>
            <h1 class="fw-bold text-light mb-2 display-5">@Model.Name</h1>
            <p class="text-secondary lead mb-3" style="max-width: 650px;">@(Model.Bio ?? "African musical powerhouse and recording artist.")</p>
            <div class="d-flex gap-2 flex-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.SpotifyUrl))
                {
                    <a href="@Model.SpotifyUrl" target="_blank" class="btn btn-sm btn-outline-glass">Spotify ↗</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.InstagramUrl))
                {
                    <a href="@Model.InstagramUrl" target="_blank" class="btn btn-sm btn-outline-glass">Instagram ↗</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.YouTubeUrl))
                {
                    <a href="@Model.YouTubeUrl" target="_blank" class="btn btn-sm btn-outline-glass">YouTube ↗</a>
                }
            </div>
        </div>
    </div>
</div>

<!-- Popular Tracks by Artist -->
@if (Model.Tracks.Any())
{
    <section class="mb-5">
        <h3 class="fw-bold text-light mb-3">🎵 Top Releases by @Model.Name</h3>
        <div class="media-grid">
            @foreach (var track in Model.Tracks)
            {
                <div class="media-card">
                    <div class="media-cover-container">
                        <img src="@(track.CoverImagePath ?? "/images/default-cover.jpg")" alt="@track.Title" class="media-cover-img" />
                        <button class="play-hover-btn" 
                                data-play-track 
                                data-track-id="@track.Id"
                                data-track-title="@track.Title"
                                data-track-artist="@track.Artist"
                                data-track-cover="@(track.CoverImagePath ?? "/images/default-cover.jpg")">
                            ▶
                        </button>
                    </div>
                    <div class="media-title">
                        <a asp-controller="Music" asp-action="Details" asp-route-id="@track.Id" class="text-light">@track.Title</a>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25 small text-muted">
                        <span>⬇ @track.DownloadCount</span>
                        <a href="/Media/DownloadMusic/@track.Id" class="text-primary fw-bold">Download</a>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Albums by Artist -->
@if (Model.Albums.Any())
{
    <section class="mb-5">
        <h3 class="fw-bold text-light mb-3">💿 Albums & EPs</h3>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @foreach (var album in Model.Albums)
            {
                <div class="col">
                    <div class="glass-card p-3">
                        <img src="@(album.CoverImagePath ?? "/images/default-cover.jpg")" alt="@album.Title" class="w-100 rounded-3 mb-2" style="aspect-ratio: 1/1; object-fit: cover;" />
                        <h5 class="fw-bold text-light mb-1">
                            <a asp-controller="Albums" asp-action="Details" asp-route-slug="@album.Slug" class="text-light text-decoration-none">@album.Title</a>
                        </h5>
                        <div class="small text-muted">@album.TrackCount Tracks</div>
                    </div>
                </div>
            }
        </div>
    </section>
}
