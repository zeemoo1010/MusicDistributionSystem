@model MusicDistributionSystem.Application.DTOs.ArtistDtos.CreateArtistRequestDto
@{
    ViewData["Title"] = "Create Artist Profile";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4 p-md-5">
            <h2 class="fw-bold text-light mb-1">Create Artist Profile</h2>
            <p class="text-muted small mb-4">Establish an official creator hub on SoundSphere</p>

            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label text-light">Artist / Stage Name *</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Burna Boy" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Country of Origin</label>
                    <input asp-for="Country" class="form-control" placeholder="e.g. Nigeria" />
                </div>

                <div class="mb-3">
                    <label class="form-label text-light">Biography</label>
                    <textarea asp-for="Bio" class="form-control" rows="3" placeholder="Tell fans about the artist's journey, achievements, and sound..."></textarea>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label text-light">Profile Picture</label>
                        <input asp-for="ProfilePicture" type="file" class="form-control" accept="image/*" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-light">Banner Image</label>
                        <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label text-light">Spotify URL</label>
                        <input asp-for="SpotifyUrl" class="form-control" placeholder="https://open.spotify.com/artist/..." />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-light">Instagram URL</label>
                        <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/..." />
                    </div>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-brand btn-lg px-4">Create Artist</button>
                    <a asp-action="Index" class="btn btn-outline-glass btn-lg">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
