@model MusicDistributionSystem.Application.DTOs.Admin.AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="page-intro mb-4">
    <h1>Admin dashboard</h1>
    <p>Manage platform users, role assignments, and high-level moderation visibility.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalUsers</span>
            <span class="stat-label">Total users</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalTracks</span>
            <span class="stat-label">Total tracks</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.PendingTracks</span>
            <span class="stat-label">Pending tracks</span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stat-card">
            <span class="stat-value">@Model.ApprovedTracks</span>
            <span class="stat-label">Approved tracks</span>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-6">
        <div class="stat-card">
            <span class="stat-value">@Model.RejectedTracks</span>
            <span class="stat-label">Rejected tracks</span>
        </div>
    </div>
    <div class="col-md-6">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalCategories</span>
            <span class="stat-label">Categories</span>
        </div>
    </div>
</div>

<section class="content-card mb-4">
    <h2>Category management</h2>
    <form asp-action="CreateCategory" method="post" class="row g-3 mt-1">
        <div class="col-md-4">
            <label class="form-label" for="create-category-name">Category name</label>
            <input class="form-control" id="create-category-name" name="Name" required />
        </div>
        <div class="col-md-6">
            <label class="form-label" for="create-category-description">Description</label>
            <input class="form-control" id="create-category-description" name="Description" />
        </div>
        <div class="col-md-2 d-grid">
            <button class="btn btn-brand align-self-end" type="submit">Add category</button>
        </div>
    </form>

    <div class="table-responsive mt-4">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Tracks</th>
                    <th>Update</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model.Categories)
                {
                    <tr>
                        <td>@category.Name</td>
                        <td>@(string.IsNullOrWhiteSpace(category.Description) ? "No description" : category.Description)</td>
                        <td>@category.LinkedTrackCount</td>
                        <td>
                            <form asp-action="UpdateCategory" method="post" class="row g-2">
                                <input type="hidden" name="Id" value="@category.Id" />
                                <div class="col-md-4">
                                    <input class="form-control" name="Name" value="@category.Name" required />
                                </div>
                                <div class="col-md-6">
                                    <input class="form-control" name="Description" value="@category.Description" />
                                </div>
                                <div class="col-md-2 d-grid">
                                    <button class="btn btn-sm btn-brand" type="submit">Save</button>
                                </div>
                            </form>
                        </td>
                        <td>
                            <form asp-action="DeleteCategory" method="post">
                                <input type="hidden" name="id" value="@category.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

<section class="content-card">
    <h2>User role management</h2>
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Roles</th>
                    <th>Update</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@(user.IsActive ? "Active" : "Inactive") / @(user.IsEmailVerified ? "Verified" : "Pending")</td>
                        <td>@string.Join(", ", user.Roles)</td>
                        <td>
                            <form asp-action="UpdateUserRoles" method="post" class="d-flex flex-column gap-2">
                                <input type="hidden" name="UserId" value="@user.UserId" />
                                <select class="form-select" name="Roles" multiple size="4">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        if (user.Roles.Contains(role))
                                        {
                                            <option selected value="@role">@role</option>
                                        }
                                        else
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-brand" type="submit">Save roles</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>


