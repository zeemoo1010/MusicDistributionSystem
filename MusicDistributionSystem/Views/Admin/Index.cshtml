@model MusicDistributionSystem.DTOs.Admin.AdminDashboardDto

@{
    ViewData["Title"] = "Admin Dashboard";
}

<section class="page-intro mb-4">
    <h1>Admin dashboard</h1>
    <p>Manage platform users, role assignments, and high-level moderation visibility.</p>
</section>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-value">@Model.TotalUsers</span>
            <span class="stat-label">Total users</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-value">@Model.PendingTracks</span>
            <span class="stat-label">Pending tracks</span>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <span class="stat-value">@Model.ApprovedTracks</span>
            <span class="stat-label">Approved tracks</span>
        </div>
    </div>
</div>

<section class="content-card">
    <h2>User role management</h2>
    <div class="table-responsive mt-3">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Roles</th>
                    <th>Update</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.Users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@(user.IsActive ? "Active" : "Inactive") / @(user.IsEmailVerified ? "Verified" : "Pending")</td>
                        <td>@string.Join(", ", user.Roles)</td>
                        <td>
                            <form asp-action="UpdateUserRoles" method="post" class="d-flex flex-column gap-2">
                                <input type="hidden" name="UserId" value="@user.UserId" />
                                <select class="form-select" name="Roles" multiple size="4">
                                    @foreach (var role in Model.AvailableRoles)
                                    {
                                        if (user.Roles.Contains(role))
                                        {
                                            <option selected value="@role">@role</option>
                                        }
                                        else
                                        {
                                            <option value="@role">@role</option>
                                        }
                                    }
                                </select>
                                <button class="btn btn-sm btn-brand" type="submit">Save roles</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
