@model MusicDistributionSystem.Application.DTOs.AlbumDtos.AlbumDetailsDto
@{
    ViewData["Title"] = $"{Model.Title} by {Model.ArtistName}";
}

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="glass-card p-4 text-center">
            <img src="@(Model.CoverImagePath ?? "/images/default-cover.jpg")" alt="@Model.Title" class="w-100 rounded-4 mb-3 shadow-lg" style="aspect-ratio: 1/1; object-fit: cover;" />
            <h3 class="fw-bold text-light mb-1">@Model.Title</h3>
            <h5 class="text-muted mb-2">
                <a asp-controller="Artists" asp-action="Details" asp-route-slug="@(Model.ArtistName.ToLower().Replace(" ", "-"))" class="text-primary text-decoration-none">
                    @Model.ArtistName
                </a>
            </h5>
            <span class="badge-tier badge-tier-@Model.AccessLevel.ToString().ToLower()">@Model.AccessLevel</span>
            <p class="text-secondary small mt-3">@(Model.Description ?? "Full album collection.")</p>
        </div>
    </div>

    <div class="col-md-8">
        <div class="glass-card p-4">
            <h4 class="fw-bold text-light mb-3">🎵 Album Tracklist (@Model.Tracks.Count Tracks)</h4>
            @if (Model.Tracks.Any())
            {
                int trackNo = 1;
                @foreach (var track in Model.Tracks)
                {
                    <div class="chart-row">
                        <div class="chart-rank">@trackNo</div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-bold text-light text-truncate">@track.Title</div>
                            <div class="small text-muted">@(track.Duration ?? "3:30")</div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-brand px-3" 
                                    data-play-track 
                                    data-track-id="@track.Id"
                                    data-track-title="@track.Title"
                                    data-track-artist="@track.Artist"
                                    data-track-cover="@(track.CoverImagePath ?? Model.CoverImagePath ?? "/images/default-cover.jpg")">
                                ▶ Play
                            </button>
                            <a href="/Media/DownloadMusic/@track.Id" class="btn btn-sm btn-outline-glass">⬇</a>
                        </div>
                    </div>
                    trackNo++;
                }
            }
            else
            {
                <p class="text-muted">No tracks added to this album yet.</p>
            }
        </div>
    </div>
</div>
