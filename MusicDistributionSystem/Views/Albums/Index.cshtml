@model IReadOnlyCollection<MusicDistributionSystem.Application.DTOs.AlbumDtos.AlbumCardDto>
@{
    ViewData["Title"] = "Albums & EPs - Discography";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
    <div>
        <h2 class="fw-bold text-light m-0">💿 Albums & Discography</h2>
        <p class="text-muted small m-0">Explore full-length studio albums, EPs, and compilations</p>
    </div>
    @if (User.IsInRole("Artist") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
    {
        <a asp-action="Create" class="btn btn-brand">+ Create Album</a>
    }
</div>

<div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
    @foreach (var album in Model)
    {
        <div class="col">
            <div class="glass-card p-3 h-100 d-flex flex-column">
                <a asp-action="Details" asp-route-slug="@album.Slug" class="text-decoration-none">
                    <img src="@(album.CoverImagePath ?? "/images/default-cover.jpg")" alt="@album.Title" class="w-100 rounded-3 mb-2 shadow" style="aspect-ratio: 1/1; object-fit: cover;" />
                    <h5 class="fw-bold text-light mb-1 text-truncate">@album.Title</h5>
                </a>
                <div class="text-muted small mb-2 text-truncate">@album.ArtistName</div>
                <div class="d-flex justify-content-between align-items-center mt-auto pt-2 border-top border-secondary border-opacity-25 small text-secondary">
                    <span class="badge-tier badge-tier-@album.AccessLevel.ToString().ToLower()">@album.AccessLevel</span>
                    <span>🎵 @album.TrackCount Tracks</span>
                </div>
            </div>
        </div>
    }
</div>
