@model MusicDistributionSystem.Application.DTOs.Payment.PaymentCheckoutDto

@{
    ViewData["Title"] = "Payment Checkout";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Subscription Checkout</span>
        <h1>@Model.PlanName</h1>
        <p class="text-muted">@Model.Description</p>

        <div class="checkout-summary mt-4">
            <div class="detail-row">
                <span>Tier</span>
                <strong>@Model.TierName</strong>
            </div>
            <div class="detail-row">
                <span>Monthly price</span>
                <strong>@(Model.MonthlyPrice == 0 ? "Free" : $"NGN {Model.MonthlyPrice:N0}/month")</strong>
            </div>
        </div>

        <div class="tier-note mt-4">
            You will be redirected to Paystack's secure payment page to complete your subscription. We do not store your card details.
        </div>

        @if (Model.MonthlyPrice > 0)
        {
            <form asp-action="Initialize" asp-controller="Payment" method="post">
                <input type="hidden" name="planId" value="@Model.PlanId" />
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <button class="btn btn-brand btn-lg" type="submit">Proceed to Paystack</button>
                    <a class="btn btn-outline-dark btn-lg" asp-controller="Home" asp-action="Index">Back to plans</a>
                </div>
            </form>
        }
        else
        {
            <div class="mt-4">
                <p class="text-success">This plan is free. No payment required.</p>
                <a class="btn btn-brand btn-lg" asp-controller="Home" asp-action="Index">Start for free</a>
            </div>
        }
    </div>
</section>
