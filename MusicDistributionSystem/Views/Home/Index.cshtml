@model MusicDistributionSystem.Application.DTOs.Home.HomeIndexDto
@{
    ViewData["Title"] = "Discover Trending Music, Videos & Playlists";
}

<!-- Hero Glassmorphism Showcase -->
<div class="hero-glass mb-5">
    <div class="row align-items-center g-4">
        <div class="col-lg-7">
            <span class="badge bg-primary bg-opacity-25 text-primary border border-primary border-opacity-50 px-3 py-2 rounded-pill mb-3 fw-bold">
                ⚡ Africa's Next-Gen Digital Media Hub
            </span>
            <h1 class="hero-title mb-3">
                Stream, Discover & Download <span class="hero-title-gradient">Pure Sound</span>
            </h1>
            <p class="text-secondary lead mb-4" style="max-width: 540px;">
                Experience high-fidelity streaming, direct MP3/MP4 downloads, exclusive artist drops, curated playlists, and 4K wallpapers.
            </p>
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <a class="btn btn-brand btn-lg" asp-controller="Music" asp-action="Index">Explore Music</a>
                <a class="btn btn-outline-glass btn-lg" asp-controller="Payment" asp-action="Plans">Get Premium</a>
            </div>
        </div>
        <div class="col-lg-5">
            <!-- Platform Metrics Panel -->
            <div class="p-4 rounded-4" style="background: rgba(15, 20, 34, 0.85); border: 1px solid var(--border);">
                <h5 class="fw-bold mb-3 text-light">🔥 Live Platform Pulse</h5>
                <div class="row g-3 text-center">
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                            <div class="fs-3 fw-bold text-primary">@Model.ApprovedTrackCount</div>
                            <div class="small text-muted">Active Tracks</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                            <div class="fs-3 fw-bold text-success">@Model.TotalDownloads.ToString("N0")</div>
                            <div class="small text-muted">Downloads Served</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                            <div class="fs-3 fw-bold text-warning">@Model.VideoCount</div>
                            <div class="small text-muted">Music Videos</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                            <div class="fs-3 fw-bold text-info">@Model.ArtistCount</div>
                            <div class="small text-muted">Verified Artists</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Featured Artists (Circle Avatars) -->
@if (Model.FeaturedArtists.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold m-0 text-light">🌟 Featured Artists</h3>
                <p class="text-muted small m-0">Top chart-topping creators and musicians</p>
            </div>
            <a asp-controller="Artists" asp-action="Index" class="btn btn-sm btn-outline-glass">View All Artists &rarr;</a>
        </div>
        <div class="row row-cols-2 row-cols-md-3 row-cols-lg-6 g-3">
            @foreach (var artist in Model.FeaturedArtists)
            {
                <div class="col">
                    <a asp-controller="Artists" asp-action="Details" asp-route-slug="@artist.Slug" class="text-decoration-none">
                        <div class="artist-circle-card">
                            <img src="@(artist.ProfilePicturePath ?? "/images/default-avatar.jpg")" alt="@artist.Name" class="artist-avatar" loading="lazy" />
                            <div class="fw-bold text-light text-truncate">@artist.Name</div>
                            <div class="small text-muted">@(artist.Country ?? "Artist")</div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </section>
}

<!-- Trending Tracks Today -->
@if (Model.TrendingTracks.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold m-0 text-light">🔥 Trending Right Now</h3>
                <p class="text-muted small m-0">Most played and downloaded tracks this week</p>
            </div>
            <a asp-controller="Music" asp-action="Index" class="btn btn-sm btn-outline-glass">Browse Music &rarr;</a>
        </div>
        <div class="media-grid">
            @foreach (var track in Model.TrendingTracks)
            {
                <div class="media-card">
                    <div class="media-cover-container">
                        <img src="@(track.CoverImagePath ?? "/images/default-cover.jpg")" alt="@track.Title" class="media-cover-img" loading="lazy" />
                        <button class="play-hover-btn" 
                                data-play-track 
                                data-track-id="@track.Id"
                                data-track-title="@track.Title"
                                data-track-artist="@track.Artist"
                                data-track-cover="@(track.CoverImagePath ?? "/images/default-cover.jpg")"
                                title="Play Track">
                            ▶
                        </button>
                    </div>
                    <div class="media-title" title="@track.Title">
                        <a asp-controller="Music" asp-action="Details" asp-route-id="@track.Id" class="text-light">@track.Title</a>
                    </div>
                    <div class="media-sub">@track.Artist</div>
                    <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25">
                        <span class="badge-tier badge-tier-@track.AccessLevel.ToString().ToLower()">@track.AccessLevel</span>
                        <a href="/Media/DownloadMusic/@track.Id" class="text-muted small" title="Download">⬇ @track.DownloadCount</a>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Dual Column: Top 10 Charts & Editorial Playlists -->
<div class="row g-4 mb-5">
    <!-- Top Charts -->
    <div class="col-lg-6">
        <div class="p-3 p-md-4 glass-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold m-0 text-light">🏆 Top Charts</h4>
                <span class="badge bg-warning bg-opacity-25 text-warning">Verified</span>
            </div>
            @if (Model.TopChartTracks.Any())
            {
                int rank = 1;
                @foreach (var track in Model.TopChartTracks.Take(5))
                {
                    <div class="chart-row">
                        <div class="chart-rank">@rank</div>
                        <img src="@(track.CoverImagePath ?? "/images/default-cover.jpg")" alt="@track.Title" style="width: 46px; height: 46px; border-radius: 8px; object-fit: cover;" loading="lazy" />
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-bold text-light text-truncate">@track.Title</div>
                            <div class="small text-muted text-truncate">@track.Artist</div>
                        </div>
                        <button class="btn btn-sm btn-outline-glass px-3" 
                                data-play-track 
                                data-track-id="@track.Id"
                                data-track-title="@track.Title"
                                data-track-artist="@track.Artist"
                                data-track-cover="@(track.CoverImagePath ?? "/images/default-cover.jpg")">
                            ▶
                        </button>
                    </div>
                    rank++;
                }
            }
        </div>
    </div>

    <!-- Editorial Playlists -->
    <div class="col-lg-6">
        <div class="p-3 p-md-4 glass-card h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="fw-bold m-0 text-light">🎧 Editorial Playlists</h4>
                <a asp-controller="Playlists" asp-action="Index" class="btn btn-sm btn-outline-glass">View All</a>
            </div>
            <div class="row g-3">
                @foreach (var playlist in Model.PublicPlaylists.Take(4))
                {
                    <div class="col-6">
                        <a asp-controller="Playlists" asp-action="Details" asp-route-slug="@playlist.Slug" class="text-decoration-none">
                            <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                                <img src="@(playlist.CoverImagePath ?? "/images/default-cover.jpg")" alt="@playlist.Title" class="w-100 rounded-3 mb-2" style="aspect-ratio: 16/9; object-fit: cover;" loading="lazy" />
                                <div class="fw-bold text-light text-truncate">@playlist.Title</div>
                                <div class="small text-muted">@playlist.TrackCount Tracks</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Featured Music Videos -->
@if (Model.FeaturedVideos.Any())
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold m-0 text-light">🎬 Trending Music Videos</h3>
                <p class="text-muted small m-0">HD & 4K music video premieres and visuals</p>
            </div>
            <a asp-controller="Videos" asp-action="Index" class="btn btn-sm btn-outline-glass">Watch More &rarr;</a>
        </div>
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3">
            @foreach (var video in Model.FeaturedVideos)
            {
                <div class="col">
                    <div class="media-card">
                        <div class="position-relative rounded-3 overflow-hidden" style="aspect-ratio: 16/9; background: #000;">
                            <img src="@(video.ThumbnailPath ?? "/images/default-cover.jpg")" alt="@video.Title" class="w-100 h-100 object-fit-cover" loading="lazy" />
                            <a asp-controller="Videos" asp-action="Watch" asp-route-slug="@video.Slug" class="position-absolute inset-0 d-flex align-items-center justify-content-center bg-dark bg-opacity-50 text-light fs-3">
                                ▶
                            </a>
                        </div>
                        <div class="media-title mt-2">
                            <a asp-controller="Videos" asp-action="Watch" asp-route-slug="@video.Slug" class="text-light">@video.Title</a>
                        </div>
                        <div class="media-sub">@video.ArtistName</div>
                        <div class="d-flex justify-content-between align-items-center mt-2 pt-2 border-top border-secondary border-opacity-25 small text-muted">
                            <span>👁 @video.ViewCount views</span>
                            <span>⬇ @video.DownloadCount</span>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

<!-- Membership Pricing Banner -->
<section class="p-5 rounded-4 text-center my-5" style="background: linear-gradient(135deg, rgba(139, 92, 246, 0.15) 0%, rgba(6, 182, 212, 0.15) 100%), var(--bg-card); border: 1px solid var(--border-highlight);">
    <h2 class="fw-bold text-light mb-2">Upgrade to SoundSphere PRO</h2>
    <p class="text-secondary mx-auto mb-4" style="max-width: 500px;">
        Enjoy unlimited high-speed downloads, ad-free streaming, artist dashboard tools, and exclusive releases.
    </p>
    <a asp-controller="Payment" asp-action="Plans" class="btn btn-brand btn-lg px-5">View Membership Plans</a>
</section>
