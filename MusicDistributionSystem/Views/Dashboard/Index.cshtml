@model MusicDistributionSystem.Application.DTOs.Dashboard.DashboardIndexDto

@{
    ViewData["Title"] = "My Dashboard";
}

<section class="page-intro mb-4">
    <h1>My dashboard</h1>
    <p>Manage your profile access and review the status of your submissions.</p>
</section>

<section class="content-card mb-4">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="content-meta">Username</div>
            <div>@Model.Username</div>
        </div>
        <div class="col-md-4">
            <div class="content-meta">Email</div>
            <div>@Model.Email</div>
        </div>
        <div class="col-md-4">
            <div class="content-meta">Roles</div>
            <div>@string.Join(", ", Model.Roles)</div>
        </div>
    </div>
</section>

<section class="content-card p-3 p-md-4">
    <h2 class="h4 fw-bold text-light mb-3">My Uploads</h2>
    @if (Model.Uploads.Any())
    {
        <!-- Mobile Card List (d-md-none) -->
        <div class="d-md-none d-flex flex-column gap-3">
            @foreach (var upload in Model.Uploads)
            {
                <div class="p-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border);">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <div class="fw-bold text-light">@upload.Title</div>
                            <div class="small text-muted">@upload.Artist</div>
                        </div>
                        <span class="badge bg-secondary bg-opacity-50 text-light">@upload.ApprovalStatus</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center text-muted small pt-2 border-top border-secondary border-opacity-25 mt-2">
                        <span>Submitted: @upload.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                        <form asp-action="DeleteUpload" method="post" class="d-inline">
                            <input type="hidden" name="id" value="@upload.Id" />
                            <button class="btn btn-sm btn-outline-danger px-2 py-1" type="submit">Delete</button>
                        </form>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(upload.RejectionReason))
                    {
                        <div class="text-danger small fw-semibold mt-2">Reason: @upload.RejectionReason</div>
                    }
                </div>
            }
        </div>

        <!-- Desktop Table (d-none d-md-block) -->
        <div class="table-responsive mt-3 d-none d-md-block">
            <table class="table align-middle text-light">
                <thead>
                    <tr class="text-muted">
                        <th>Title</th>
                        <th>Artist</th>
                        <th>Status</th>
                        <th>Access</th>
                        <th>Review</th>
                        <th>Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var upload in Model.Uploads)
                    {
                        <tr>
                            <td class="fw-semibold">@upload.Title</td>
                            <td>@upload.Artist</td>
                            <td><span class="badge bg-secondary bg-opacity-50">@upload.ApprovalStatus</span></td>
                            <td><span class="badge-tier badge-tier-@upload.AccessLevel.ToString().ToLower()">@upload.AccessLevel</span></td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(upload.RejectionReason))
                                {
                                    <div class="text-danger small fw-semibold">@upload.RejectionReason</div>
                                }
                                @if (upload.ReviewedAtUtc.HasValue)
                                {
                                    <div class="text-muted small">@upload.ReviewedAtUtc.Value.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</div>
                                }
                                @if (string.IsNullOrWhiteSpace(upload.RejectionReason) && !upload.ReviewedAtUtc.HasValue)
                                {
                                    <span class="text-muted small">Awaiting review</span>
                                }
                            </td>
                            <td>@upload.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</td>
                            <td>
                                <form asp-action="DeleteUpload" method="post">
                                    <input type="hidden" name="id" value="@upload.Id" />
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p class="text-muted mt-3">You have not uploaded any tracks yet.</p>
    }
</section>


