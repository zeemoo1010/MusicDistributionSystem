@model MusicDistributionSystem.Application.DTOs.ImageDtos.ImageDetailsDto
@{
    ViewData["Title"] = $"{Model.Title} - Wallpaper & Artwork";
}

<div class="row g-4 justify-content-center">
    <div class="col-lg-8">
        <div class="glass-card p-4">
            <img src="@Model.FilePath" alt="@Model.Title" class="w-100 rounded-4 shadow-lg mb-4" />
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                <div>
                    <h2 class="fw-bold text-light mb-1">@Model.Title</h2>
                    <div class="text-muted small">Uploaded by @Model.UploadedByName • @Model.CreatedAt.ToString("MMMM dd, yyyy")</div>
                </div>
                <a href="/Media/DownloadImage/@Model.Id" class="btn btn-brand btn-lg">⬇ Download High-Res</a>
            </div>
            <hr class="border-secondary border-opacity-25 my-3" />
            <p class="text-secondary">@(Model.Description ?? "High resolution artwork.")</p>
        </div>
    </div>
</div>
