<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>@ViewData["Title"] - SoundSphere Digital Media</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/MusicDistributionSystem.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Loading Overlay -->
    <div id="loading-overlay" class="loading-overlay" aria-hidden="true">
        <div class="loading-spinner"></div>
    </div>

    <!-- Toast Notifications Container -->
    <div id="toast-container" class="toast-container" aria-live="polite"></div>

    <!-- Header Navigation -->
    <header class="site-header">
        <nav class="navbar navbar-expand-xl navbar-dark">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand me-2 me-lg-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <span style="font-size: 1.5rem;">🎵</span> SoundSphere
                </a>
                <div class="d-flex align-items-center gap-2 d-xl-none">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Artist") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <a class="btn btn-sm btn-brand px-2 py-1" asp-controller="Music" asp-action="Upload" title="Upload Music">+ Upload</a>
                        }
                    }
                    <button class="navbar-toggler border-0 p-2" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                </div>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Discover</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Music" asp-action="Index">Music</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Artists" asp-action="Index">Artists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Albums" asp-action="Index">Albums</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Videos" asp-action="Index">Videos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Playlists" asp-action="Index">Playlists</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Images" asp-action="Index">Wallpapers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payment" asp-action="Plans">
                                Premium <span class="nav-badge-premium">PRO</span>
                            </a>
                        </li>
                        @if (User.IsInRole("Moderator") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning" asp-controller="Moderation" asp-action="Index">Moderation</a>
                            </li>
                        }
                        @if (User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info" asp-controller="Admin" asp-action="Index">Admin Hub</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 flex-wrap pt-2 pt-xl-0 border-top border-xl-0 border-secondary border-opacity-25 mt-2 mt-xl-0">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a class="btn btn-sm btn-outline-glass" asp-controller="Dashboard" asp-action="Index">
                                👤 @User.Identity.Name
                            </a>
                            @if (User.IsInRole("Artist") || User.IsInRole("Admin") || User.IsInRole("SuperAdmin"))
                            {
                                <div class="dropdown d-none d-xl-inline-block">
                                    <button class="btn btn-sm btn-brand dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                        + Upload
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow">
                                        <li><a class="dropdown-item" asp-controller="Music" asp-action="Upload">Upload Track (MP3)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Videos" asp-action="Upload">Upload Video (MP4)</a></li>
                                        <li><a class="dropdown-item" asp-controller="Images" asp-action="Upload">Upload Artwork / Wallpaper</a></li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li><a class="dropdown-item" asp-controller="Albums" asp-action="Create">Create Album</a></li>
                                        <li><a class="dropdown-item" asp-controller="Artists" asp-action="Create">Add Artist Profile</a></li>
                                    </ul>
                                </div>
                            }
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="btn btn-sm btn-outline-secondary text-light" type="submit">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-glass" asp-controller="Account" asp-action="Login">Log In</a>
                            <a class="btn btn-sm btn-brand" asp-controller="Account" asp-action="Register">Join Free</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- Main Content Container -->
    <div class="container-fluid px-3 px-lg-4 py-3 py-lg-4 page-shell">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Persistent Global Audio Player Bar -->
    <div id="global-player-bar" class="global-player-bar" style="display: none;">
        <audio id="global-audio-element" preload="none"></audio>
        <div class="player-track-info">
            <img id="player-thumb" src="/images/default-cover.jpg" alt="Artwork" class="player-thumb" />
            <div class="player-meta">
                <div id="player-title" class="player-track-title">Select a track</div>
                <div id="player-artist" class="player-track-artist">SoundSphere Media</div>
            </div>
        </div>

        <div class="player-controls-center">
            <div class="player-buttons">
                <button id="player-prev-btn" class="player-btn" title="Previous" aria-label="Previous Track">⏮</button>
                <button id="player-play-btn" class="player-btn player-btn-play" title="Play / Pause" aria-label="Play or Pause">▶</button>
                <button id="player-next-btn" class="player-btn" title="Next" aria-label="Next Track">⏭</button>
            </div>
            <div class="player-progress-row">
                <span id="player-current-time">0:00</span>
                <input id="player-progress-slider" type="range" class="player-slider" min="0" max="100" value="0" aria-label="Seek track position" />
                <span id="player-duration-time">0:00</span>
            </div>
        </div>

        <div class="player-volume-zone">
            <button id="player-mute-btn" class="player-btn" title="Mute" aria-label="Mute / Unmute">🔊</button>
            <input id="player-volume-slider" type="range" class="player-slider" min="0" max="100" value="85" style="width: 90px;" aria-label="Volume level" />
        </div>
    </div>

    <!-- Mobile Bottom Navigation Bar (< 768px) -->
    <nav class="mobile-bottom-nav d-md-none" aria-label="Mobile Navigation">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item" data-nav-route="Home">
            <span class="mobile-nav-icon">🧭</span>
            <span class="mobile-nav-label">Discover</span>
        </a>
        <a asp-controller="Music" asp-action="Index" class="mobile-nav-item" data-nav-route="Music">
            <span class="mobile-nav-icon">🎵</span>
            <span class="mobile-nav-label">Music</span>
        </a>
        <a asp-controller="Videos" asp-action="Index" class="mobile-nav-item" data-nav-route="Videos">
            <span class="mobile-nav-icon">🎬</span>
            <span class="mobile-nav-label">Videos</span>
        </a>
        <a asp-controller="Images" asp-action="Index" class="mobile-nav-item" data-nav-route="Images">
            <span class="mobile-nav-icon">🖼️</span>
            <span class="mobile-nav-label">Wallpapers</span>
        </a>
        <a asp-controller="@(User.Identity?.IsAuthenticated == true ? "Dashboard" : "Account")" 
           asp-action="@(User.Identity?.IsAuthenticated == true ? "Index" : "Login")" 
           class="mobile-nav-item" data-nav-route="Dashboard">
            <span class="mobile-nav-icon">👤</span>
            <span class="mobile-nav-label">@(User.Identity?.IsAuthenticated == true ? "Library" : "Sign In")</span>
        </a>
    </nav>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        @if (TempData["SuccessMessage"] is string successMsg)
        {
            <text>Toast.success("Success", "@successMsg");</text>
        }
        @if (TempData["ErrorMessage"] is string errorMsg)
        {
            <text>Toast.error("Notice", "@errorMsg");</text>
        }
        @if (TempData["StatusMessage"] is string statusMsg)
        {
            <text>Toast.info("Status", "@statusMsg");</text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
