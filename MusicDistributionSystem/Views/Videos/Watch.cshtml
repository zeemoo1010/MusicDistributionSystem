@model MusicDistributionSystem.Application.DTOs.VideoDtos.VideoDetailsDto
@{
    ViewData["Title"] = $"{Model.Title} - Watch Video";
}

<div class="row g-4 mb-5">
    <div class="col-lg-8">
        <!-- HTML5 Video Player with Byte-Range Streaming -->
        <div class="rounded-4 overflow-hidden shadow-lg mb-3" style="background: #000; aspect-ratio: 16/9;">
            <video controls class="w-100 h-100" poster="@(Model.ThumbnailPath ?? "/images/default-cover.jpg")" preload="metadata">
                <source src="/Media/StreamVideo/@Model.Id" type="video/mp4" />
                Your browser does not support the video tag.
            </video>
        </div>

        <div class="glass-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
                <div>
                    <h2 class="fw-bold text-light mb-1">@Model.Title</h2>
                    <h5 class="text-muted mb-2">@Model.ArtistName</h5>
                    <div class="d-flex gap-2 align-items-center small text-muted">
                        <span>👁 @Model.ViewCount views</span>
                        <span>•</span>
                        <span>Released @Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <a href="/Media/DownloadVideo/@Model.Id" class="btn btn-brand">⬇ Download Video</a>
                </div>
            </div>

            <hr class="border-secondary border-opacity-25 my-3" />
            <p class="text-secondary mb-0">@(Model.Description ?? "Official Music Video.")</p>
        </div>

        <!-- Video Comments -->
        <div class="glass-card p-4">
            <h4 class="fw-bold text-light mb-3">💬 Comments (@Model.Comments.Count)</h4>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form asp-action="AddComment" method="post" class="mb-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="videoId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="mb-2">
                        <textarea name="content" class="form-control" rows="2" placeholder="Leave a comment on this video..." required></textarea>
                    </div>
                    <button type="submit" class="btn btn-sm btn-brand">Post Comment</button>
                </form>
            }
            else
            {
                <div class="p-3 rounded-3 mb-4 text-center" style="background: rgba(255,255,255,0.03); border: 1px solid var(--border);">
                    <a asp-controller="Account" asp-action="Login" class="text-primary fw-bold">Log in to comment</a>
                </div>
            }

            @if (Model.Comments.Any())
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var c in Model.Comments)
                    {
                        <div class="p-3 rounded-3" style="background: rgba(255,255,255,0.02); border: 1px solid var(--border);">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-light">👤 @c.Username</strong>
                                <span class="text-muted small">@c.CreatedAt.ToString("g")</span>
                            </div>
                            <p class="text-secondary m-0">@c.Content</p>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Right Sidebar Meta -->
    <div class="col-lg-4">
        <div class="glass-card p-4">
            <h5 class="fw-bold text-light mb-3">Video Details</h5>
            <div class="d-flex flex-column gap-2 small text-secondary">
                <div class="d-flex justify-content-between">
                    <span>Category:</span>
                    <strong class="text-light">@(Model.CategoryName ?? "General")</strong>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Access Tier:</span>
                    <span class="badge-tier badge-tier-@Model.AccessLevel.ToString().ToLower()">@Model.AccessLevel</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span>Uploaded By:</span>
                    <strong class="text-light">@Model.UploadedByName</strong>
                </div>
            </div>
        </div>
    </div>
</div>
