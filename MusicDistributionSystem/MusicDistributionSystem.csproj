<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj-verify\**\*.cs" />
    <Compile Remove="bin-verify\**\*.cs" />
    <Content Remove="obj-verify\**" />
    <Content Remove="bin-verify\**" />
    <EmbeddedResource Remove="obj-verify\**" />
    <EmbeddedResource Remove="bin-verify\**" />
    <None Remove="obj-verify\**" />
    <None Remove="bin-verify\**" />
  </ItemGroup>

</Project>
