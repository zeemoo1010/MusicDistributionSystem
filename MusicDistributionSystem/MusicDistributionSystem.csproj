<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Models\**\*.cs" />
    <Compile Remove="Enums\**\*.cs" />
    <Compile Remove="Constants\**\*.cs" />
    <Compile Remove="Configuration\**\*.cs" />
    <Compile Remove="DTOs\**\*.cs" />
    <Compile Remove="Repositories\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Data\**\*.cs" />
    <Compile Remove="DbContext\**\*.cs" />
    <Compile Remove="Logging\**\*.cs" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="obj-temp\**\*.cs" />
    <Compile Remove="obj-verify\**\*.cs" />
    <Compile Remove="obj-verify2\**\*.cs" />
    <Compile Remove="bin-verify\**\*.cs" />
    <Content Remove="obj-temp\**" />
    <Content Remove="obj-verify\**" />
    <Content Remove="obj-verify2\**" />
    <Content Remove="bin-verify\**" />
    <EmbeddedResource Remove="obj-temp\**" />
    <EmbeddedResource Remove="obj-verify\**" />
    <EmbeddedResource Remove="obj-verify2\**" />
    <EmbeddedResource Remove="bin-verify\**" />
    <None Remove="obj-temp\**" />
    <None Remove="obj-verify\**" />
    <None Remove="obj-verify2\**" />
    <None Remove="bin-verify\**" />
  </ItemGroup>

</Project>
